# An example asset file. Copy it to <chain>-<address>.toml and edit, or let the
# CLI write one for you:
#
#   assayer add ethereum:0xADDRESS --label "Assay Note" \
#     --docs prospectus=https://docs.issuer.example/prospectus.pdf
#
# Files ending in .sample are ignored: only *.toml counts as an asset.

label = "Assay Note ASSY"
chain = "ethereum"
address = "0x1111111111111111111111111111111111111111"
chain_id = 1

[[documents]]
doc_id = "prospectus"
url = "https://docs.issuer.example/prospectus.pdf"
# Whatever the issuer itself calls the version of this document. The point of the
# field is to catch a substitution of the content while the declared version
# stays the same.
version = "2026-01"

[[documents]]
doc_id = "custody"
url = "https://docs.issuer.example/custody.html"

# Declared collateral. Filled in by hand, and not evidence: the tool only
# compares these figures against totalSupply and against the date the document
# itself confirms.
[reserves]
claim_doc = "custody"
claimed_units = 1200000
unit = "share"
period_days = 30
attested_at = "2026-01-31"
# The independent attestor, if one is named. Without it the snapshot emits the
# self_attested_reserves signal.
# attestor = "Independent Attestor LLP"

# Thresholds. These are your numbers, not a judgement by the tool: it reports
# that a number you wrote down was crossed, and prints the reading next to it.
# A threshold that cannot be evaluated is marked as not applied, never as
# satisfied.
[alerts]
# max_attestation_age_days = 30
# min_timelock_delay_s = 172800
# max_supply_over_claim_pct = 0.5
# require_no_freeze = true
# require_no_foreign_burn = true
# require_immutable_logic = false
